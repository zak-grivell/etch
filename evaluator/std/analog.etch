export let OpAmp = (gain: Number, low: Number, high: Number, output_conductance: Number) -> {
    let positive = use_node();
    let negative = use_node();
    let output = use_node();
    use_symbol(
        kind: "op-amp",
        ports: { positive, negative, output },
        value: gain,
        kicad: { symbol: "Amplifier_Operational:LM321", footprint: "Package_TO_SOT_SMD:SOT-23-5", pins: { positive: "1", negative: "3", output: "4" } },
    );
    use_equation(equation: () -> {
        let raw = gain * (voltage(node: positive) - voltage(node: negative));
        let limited = match raw {
            let value if value > high -> high,
            let value if value < low -> low,
            let value -> value,
        };
        drive_voltage(
            node: output,
            value: limited,
            conductance: output_conductance,
        )
    });
    return { positive, negative, output };
};

export let Comparator = (threshold: Number, low: Number, high: Number) -> {
    let input = use_node();
    let output = use_node();
    use_symbol(kind: "comparator", ports: { input, output }, value: threshold, kicad: {
        symbol: "Comparator:LM311", footprint: "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm", pins: { input: "2", output: "7" },
    });
    use_equation(equation: () -> {
        let level = match voltage(node: input) > threshold {
            true -> high,
            false -> low,
        };
        drive_voltage(node: output, value: level, conductance: 1000)
    });
    return { input, output };
};

export let Diode = (forward_voltage: Number, on_resistance: Number, off_resistance: Number) -> {
    let anode = use_node();
    let cathode = use_node();
    use_symbol(kind: "diode", ports: { anode, cathode }, value: forward_voltage, kicad: {
        symbol: "Device:D", footprint: "Diode_SMD:D_0603_1608Metric", pins: { anode: "2", cathode: "1" },
    });
    use_equation(equation: () -> {
        let resistance = match voltage(node: anode) - voltage(node: cathode) > forward_voltage {
            true -> on_resistance,
            false -> off_resistance,
        };
        conductance(between: [anode, cathode], value: 1 / resistance)
    });
    return { anode, cathode };
};

export let Led = (forward_voltage: Number, on_resistance: Number, off_resistance: Number) -> {
    let anode = use_node();
    let cathode = use_node();
    use_symbol(kind: "led", ports: { anode, cathode }, value: forward_voltage, kicad: {
        symbol: "Device:LED", footprint: "LED_SMD:LED_0603_1608Metric", pins: { anode: "2", cathode: "1" },
    });
    use_equation(equation: () -> {
        let resistance = match voltage(node: anode) - voltage(node: cathode) > forward_voltage {
            true -> on_resistance,
            false -> off_resistance,
        };
        conductance(between: [anode, cathode], value: 1 / resistance)
    });
    return { anode, cathode };
};
