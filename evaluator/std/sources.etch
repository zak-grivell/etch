type Voltage = Number(symbol: "V");
type Current = Number(symbol: "A");

export let VoltageSource = (value: Voltage) -> {
    let positive = use_node();
    let negative = use_node();
    negative <- ground;
    use_symbol(kind: "voltage-source", ports: { positive, negative }, value: value, kicad: {
        symbol: "Simulation_SPICE:VDC", footprint: "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical", pins: { positive: "1", negative: "2" },
    });
    use_equation(equation: () -> {
        fix_voltage(node: negative, value: 0);
        fix_voltage(node: positive, value: value)
    });
    return { positive, negative };
};

export let Ground = () -> {
    return { node: ground };
};

export let CurrentSource = (value: Current) -> {
    let positive = use_node();
    let negative = use_node();
    use_symbol(kind: "current-source", ports: { positive, negative }, value: value, kicad: {
        symbol: "Simulation_SPICE:IDC", footprint: "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical", pins: { positive: "1", negative: "2" },
    });
    use_equation(equation: () -> current(
        between: [positive, negative],
        value: value,
    ));
    return { positive, negative };
};
