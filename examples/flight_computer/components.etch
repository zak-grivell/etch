    });
    return { reset, vcc_rf, rf_in, tx, rx, v_bckp, vcc, gnd_1, gnd_2, gnd_3 };
};

export let Adxl343 = () -> {
    let vdd_io = use_node(); let vs = use_node(); let cs = use_node(); let int1 = use_node();
    let sdo = use_node(); let sda = use_node(); let scl = use_node(); let gnd_1 = use_node(); let gnd_2 = use_node(); let gnd_3 = use_node();
    use_symbol(kind: "ADXL343 accelerometer", ports: { vdd_io, vs, cs, int1, sdo, sda, scl, gnd_1, gnd_2, gnd_3 }, kicad: {
        symbol: "Sensor_Motion:ADXL343", footprint: "Package_LGA:LGA-14_3x5mm_P0.8mm_LayoutBorder1x6y",
        pins: { vdd_io: "1", gnd_1: "2", gnd_2: "4", gnd_3: "5", vs: "6", cs: "7", int1: "8", sdo: "12", sda: "13", scl: "14" },
    });
    return { vdd_io, vs, cs, int1, sdo, sda, scl, gnd_1, gnd_2, gnd_3 };
};

