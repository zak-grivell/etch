    let v_bckp = use_node(); let vcc = use_node(); let gnd_1 = use_node(); let gnd_2 = use_node(); let gnd_3 = use_node();
    use_symbol(kind: "u-blox NEO-M8N GPS", ports: { reset, vcc_rf, rf_in, tx, rx, v_bckp, vcc, gnd_1, gnd_2, gnd_3 }, kicad: {
