export let Connector4 = () -> {
    let pin1 = use_node(); let pin2 = use_node(); let pin3 = use_node(); let pin4 = use_node();
    use_symbol(kind: "4-pin connector", ports: { pin1, pin2, pin3, pin4 }, kicad: {
