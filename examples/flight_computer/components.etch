export let Regulator33 = () -> {
    let input = use_node(); let output = use_node(); let ground = use_node();
    use_symbol(kind: "3.3 V regulator", ports: { input, output, ground }, kicad: {
        symbol: "Regulator_Linear:AP2112K-3.3", footprint: "Package_TO_SOT_SMD:SOT-23-5", pins: { input: "1", ground: "2", output: "5" },
    });
    return { input, output, ground };
};

export let Connector2 = () -> {
    let pin1 = use_node(); let pin2 = use_node();
    use_symbol(kind: "2-pin connector", ports: { pin1, pin2 }, kicad: {
        symbol: "Connector_Generic:Conn_01x02", footprint: "Connector_JST:JST_GH_BM02B-GHS-TBT_1x02-1MP_P1.25mm_Horizontal", pins: { pin1: "1", pin2: "2" },
    });
    return { pin1, pin2 };
};

export let Connector3 = () -> {
    let pin1 = use_node(); let pin2 = use_node(); let pin3 = use_node();
    use_symbol(kind: "3-pin connector", ports: { pin1, pin2, pin3 }, kicad: {
        symbol: "Connector_Generic:Conn_01x03", footprint: "Connector_JST:JST_GH_BM03B-GHS-TBT_1x03-1MP_P1.25mm_Horizontal", pins: { pin1: "1", pin2: "2", pin3: "3" },
    });
    return { pin1, pin2, pin3 };
