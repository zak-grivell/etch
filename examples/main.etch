let TransistorSwitcher = (threshold: Voltage) -> {
    let protector = Resistor(value: 1kO) <- [
		a:control,
		b:transistor.a
	];
	
    let transistor = NPN() <- [
		base:protector.b,
		collector:out,
		emitter:gnd
	];

	return [
		vcc: resistor.a,
		control: resistor.a
	];
}};

