type Resistance = Number(symbol: "O");
type Capacitance = Number(symbol: "F");
type Inducatnce = Number(symbol: "H");

type Voltage = Number(symbol: "V");
type Current = Number(symbol: "A");

let Resistor = (value: Resistance) -> {a:Node, b:Node} {
	let a = Node();
	let b = Node();

	// once i design the simulation writing it will be here

	return {a:a, b:b};
}

let Capacitor = (value: Capacitance) -> {a:Node, b:Node} {
	let a = Node();
	let b = Node();

	// once i design the simulation writing it will be here

	return {a:a, b:b};
}

let Inductor = (value: Capacitance) -> {a:Node, b:Node} {
	let a = Node();
	let b = Node();

	// once i design the simulation writing it will be here

	return {a:a, b:b};
}

